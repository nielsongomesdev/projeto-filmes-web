datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "node-api"
}

model Ator {
  id     Int     @id @default(autoincrement())
  nome   String  @unique
  filmes Filme[]
}

model Filme {
  id         Int     @id @default(autoincrement())
  titulo     String
  faixaEtaria Int
  genero     String
  atores     Ator[]
}